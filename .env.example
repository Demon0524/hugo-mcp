# Host paths. Keep runtime data outside the repository.
HUGO_SITE_ROOT_HOST=/srv/hugo/site
HUGO_MCP_DATA_ROOT_HOST=/srv/hugo-mcp
HUGO_BIN_HOST=/usr/local/bin/hugo

# Bind to loopback by default; put TLS/authenticated reverse proxy in front
# before exposing the MCP endpoint to another network.
HUGO_MCP_BIND_ADDRESS=127.0.0.1
HUGO_MCP_PORT=8095

# The container writes Markdown and generated output during mutations.
# Match this to the ownership of HUGO_SITE_ROOT_HOST when running rootless.
HUGO_MCP_CONTAINER_USER=0:0
HUGO_BUILD_TIMEOUT=120
HUGO_MCP_MAX_BODY=2097152
